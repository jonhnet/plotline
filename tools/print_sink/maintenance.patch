+/* Serialize admission with the application's idle check and activation. Reads
+ * remain available while the installer holds the exclusive lock. */
+static int
+process_ipp(ippeve_client_t *client)
+{
+  const char *path = getenv("PLOTLINE_ADMISSION_LOCK");
+  ipp_op_t op = ippGetOperation(client->request);
+  int fd = -1, result;
+  if (path && op != IPP_OP_GET_PRINTER_ATTRIBUTES && op != IPP_OP_GET_JOB_ATTRIBUTES && op != IPP_OP_GET_JOBS)
+  {
+    fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0 || flock(fd, LOCK_SH | LOCK_NB))
+    {
+      if (fd >= 0) close(fd);
+      respond_http(client, HTTP_STATUS_SERVICE_UNAVAILABLE, NULL, NULL, 0);
+      return (0);
+    }
+  }
+  result = process_ipp_unlocked(client);
+  if (fd >= 0) close(fd);
+  return (result);
+}
+
